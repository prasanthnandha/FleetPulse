# ==============================================================================
# FleetPulse — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.

# --- Databricks ---
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_token_here
DATABRICKS_CATALOG=fleetpulse
DATABRICKS_SCHEMA=data

# --- Model Serving ---
MODEL_SERVING_ENDPOINT=fleetpulse-prediction

# --- Vector Search ---
VECTOR_SEARCH_ENDPOINT=fleetpulse-vs-endpoint
VECTOR_SEARCH_INDEX=fleetpulse.data.document_chunks_index

# --- LLM Provider (Databricks Foundation Model APIs) ---
# Options: "databricks" (default), "anthropic", "openai"
LLM_PROVIDER=databricks
DATABRICKS_MODEL=databricks-meta-llama-3-1-70b-instruct
# Alternative external providers (optional):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- RAG ---
RETRIEVAL_CONFIDENCE_THRESHOLD=0.75

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- UI Dev Server ---
VITE_API_URL=http://localhost:8000
